# Configure esses valores como segredos no ambiente de produção.
# Não inclua chaves reais neste arquivo ou no GitHub.
EMPRESTO_ADMIN_EMAIL=
REQUIRE_SUBSCRIPTION=true
# Ativar somente após cadastrar e homologar a conta Asaas.
BILLING_ENABLED=false
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
# Token inventado por você; o mesmo valor vai no webhook do painel Asaas.
ASAAS_WEBHOOK_TOKEN=
# Frase longa e aleatória; cifra os tokens do Z-API guardados no banco. Não troque depois de definida.
DATA_ENCRYPTION_KEY=
